{
  "name": "usdbee",
  "version": "1.0.0",
  "description": "Lightweight USD viewer built with Tauri, and Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "mcp": "node mcp/server.mjs",
    "tauri": "tauri",
    "release": "release-it",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "prettier --write src",
    "format:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check src && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "validate": "npm run format:check && npm run test:rust && npm test && npm run check && npm run clippy",
    "probe": "cargo run --manifest-path src-tauri/Cargo.toml --example",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml && rimraf dist node_modules"
  },
  "license": "MIT",
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@release-it/bumper": "^7.0.5",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.183.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "release-it": "^19.2.4",
    "rimraf": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
