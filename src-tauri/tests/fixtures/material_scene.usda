#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    def Mesh "PlasticBall"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/Plastic>
    }

    def Mesh "TexturedBall"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/Textured>
    }

    def Mesh "FancyBall"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/CustomShader>
    }

    def Mesh "Unbound"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Scope "Looks"
    {
        def Material "Plastic"
        {
            token outputs:surface.connect = </World/Looks/Plastic/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.2, 0.2)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.9
                token outputs:surface
            }
        }

        def Material "Textured"
        {
            token outputs:surface.connect = </World/Looks/Textured/PreviewSurface.outputs:surface>

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "uv"
                float2 outputs:result
            }
            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float2 inputs:st.connect = </World/Looks/Textured/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "NormalMap"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float2 inputs:st.connect = </World/Looks/Textured/StReader.outputs:result>
                float3 outputs:rgb
            }
            def Shader "ScalarMap"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float outputs:r
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Textured/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </World/Looks/Textured/NormalMap.outputs:rgb>
                float inputs:roughness.connect = </World/Looks/Textured/ScalarMap.outputs:r>
                float inputs:metallic.connect = </World/Looks/Textured/ScalarMap.outputs:r>
                float inputs:opacity.connect = </World/Looks/Textured/ScalarMap.outputs:r>
                token outputs:surface
            }
        }

        def Material "Missing"
        {
            token outputs:surface.connect = </World/Looks/Missing/PreviewSurface.outputs:surface>

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./does_not_exist.png@
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Missing/Albedo.outputs:rgb>
                token outputs:surface
            }
        }

        def Material "CustomShader"
        {
            token outputs:surface.connect = </World/Looks/CustomShader/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "StudioCustomPbr"
                token outputs:surface
            }
        }
    }
}
