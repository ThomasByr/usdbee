#usda 1.0
(
    defaultPrim = "Scene"
    startTimeCode = 0
    endTimeCode = 24
    timeCodesPerSecond = 24
)

def Xform "Scene"
{
    def Sphere "Pulse"
    {
        custom double size.timeSamples = {
            1: 1,
            24: 5,
        }
        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            24: (10, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Wobble"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points.timeSamples = {
            0: [(0, 0, 0), (1, 0, 0), (0, 1, 0)],
            10: [(0, 0, 0), (2, 0, 0), (0, 2, 0)],
        }
    }

    def Mesh "Still"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Xform "Mover"
    {
        double3 xformOp:translate.timeSamples = {
            0: (0, 0, 0),
            10: (5, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Child"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }
}
