#usda 1.0
(
    defaultPrim = "Scene"
    timeCodesPerSecond = 24
)

def Xform "Scene"
{
    def Sphere "Pulse"
    {
        custom double size.timeSamples = {
            1: 1,
            24: 5,
        }
        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            24: (10, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
