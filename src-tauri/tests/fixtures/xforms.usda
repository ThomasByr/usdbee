#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    double3 xformOp:translate = (10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Xform "TripletZYX"
    {
        double3 xformOp:rotateZYX = (90, 90, 90)
        uniform token[] xformOpOrder = ["xformOp:rotateZYX"]
    }

    def Xform "SinglesZYX"
    {
        double xformOp:rotateX = 90
        double xformOp:rotateY = 90
        double xformOp:rotateZ = 90
        uniform token[] xformOpOrder = ["xformOp:rotateZ", "xformOp:rotateY", "xformOp:rotateX"]
    }

    def Xform "Reset"
    {
        double3 xformOp:translate = (1, 2, 3)
        double xformOp:rotateZ = 90
        uniform token[] xformOpOrder = ["xformOp:translate", "!resetXformStack!", "xformOp:rotateZ"]
    }

    def Xform "Pivoted"
    {
        double3 xformOp:translate:pivot = (5, 0, 0)
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate:pivot", "xformOp:translate"]
    }

    def Xform "MayaPivot"
    {
        double3 xformOp:translate:pivot = (5, 0, 0)
        double xformOp:rotateZ = 90
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate:pivot", "xformOp:rotateZ", "!inverted!xformOp:translate:pivot", "xformOp:translate"]
    }

    def Xform "MayaPivotInvert"
    {
        double3 xformOp:translate:pivot = (5, 0, 0)
        double xformOp:rotateZ = 90
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate:pivot", "xformOp:rotateZ", "!invert!xformOp:translate:pivot", "xformOp:translate"]
    }

    def Xform "Unsupported"
    {
        bool xformOp:flip = 0
        uniform token[] xformOpOrder = ["xformOp:flip"]
    }

    def Xform "TimeOrient"
    {
        quatd xformOp:orient.timeSamples = {
            1: (0.7071067811865476, 0, 0, 0.7071067811865476)
        }
        uniform token[] xformOpOrder = ["xformOp:orient"]
    }

    def Xform "FloatRotate"
    {
        float xformOp:rotateY = 90
        uniform token[] xformOpOrder = ["xformOp:rotateY"]
    }
}
