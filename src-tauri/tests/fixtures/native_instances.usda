#usda 1.0
(
    defaultPrim = "Scene",
    startTimeCode = 0,
    endTimeCode = 2
)

def Xform "Scene"
{
    def Xform "Mover" (
        # a moving ancestor: only instances under this prim get animated descendants
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        double3 xformOp:translate.timeSamples = {
            0: (1, 0, 0),
            2: (2, 0, 0)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "InMotion" (
            instanceable = true
            prepend references = @./asset.usda@
        )
        {
        }
    }

    def "AtRest" (
        instanceable = true
        prepend references = @./asset.usda@
    )
    {
        double3 xformOp:translate = (0, 5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
