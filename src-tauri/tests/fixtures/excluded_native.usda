#usda 1.0
(
    defaultPrim = "Scene",
    startTimeCode = 1,
    endTimeCode = 2
)

# Blocker 4: an excluded (guide) native instance under a MOVING excluded
# ancestor. The excluded chain lifts the copies with the chain's
# transforms composed into their local matrices; the ancestor samples
# translate, so the lifted copies must ride the delta with rebuilt
# transforms.
def Xform "Scene"
{
    def Xform "Lift"
    {
        uniform token purpose = "guide"

        double3 xformOp:translate.timeSamples = {
            1: (1, 0, 0),
            2: (2, 0, 0)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "I" (
            instanceable = true
            prepend references = @./asset.usda@
        )
        {
        }
    }
}
