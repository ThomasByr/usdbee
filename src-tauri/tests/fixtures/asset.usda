#usda 1.0
(
    defaultPrim = "Model"
)

def Xform "Model"
(
    prepend variantSets = "trim"
    variants = {
        string trim = "base"
    }
)
{
    variantSet "trim" = {
        "base" {
        }
        "sport" {
            def Cube "Spoiler"
            {
            }
        }
    }

    def Sphere "Wheel"
    {
        double radius = 0.5
    }

    def Mesh "WheelMesh"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}
