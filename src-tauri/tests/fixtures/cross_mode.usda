#usda 1.0
(
    defaultPrim = "Scene",
    startTimeCode = 1,
    endTimeCode = 2
)

# Blocker 5: the SAME native prototype (both instances reference
# cross_mode_asset.usda with identical composition, so pcp mints one
# prototype) is walked FILTERED for Mover/I2 and FULL inside the
# animated instancer's prototype subtree within one delta request. The
# memo must keep the two walks apart.
def Xform "Scene"
{
    def Xform "Mover"
    {
        double3 xformOp:translate.timeSamples = {
            1: (1, 0, 0),
            2: (2, 0, 0)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "I2" (
            instanceable = true
            prepend references = @./cross_mode_asset.usda@
        )
        {
        }
    }

    def PointInstancer "Inst"
    {
        point3f[] positions.timeSamples = {
            1: [(0, 0, 0)],
            2: [(1, 0, 0)],
        }
        int[] protoIndices = [0]
        rel prototypes = [</Scene/Inst/Proto0>]

        def Xform "Proto0"
        {
            def "I1" (
                instanceable = true
                prepend references = @./cross_mode_asset.usda@
            )
            {
            }
        }
    }
}
