#usda 1.0

def Xform "Scene"
{
    # Two triangles share vertices 1 and 2. Seam's vertex 2 carries
    # different faceVarying st values per face (a UV seam): it must split
    # into two output vertices so each face samples its own region.
    def Mesh "Seam"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0.25, 0.25), (0.75, 0.25), (1, 0), (1, 1)] (
            interpolation = "faceVarying"
        )
    }

    # Same topology, but every corner of each vertex agrees: no split.
    def Mesh "Control"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (1, 1, 0)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0.25, 0.25), (0.25, 0.25), (1, 0), (1, 1)] (
            interpolation = "faceVarying"
        )
    }

    # A fold: face 1 tilts out of the XY plane, so the seam vertex's two
    # faces point different ways; generated normals must stay merged.
    def Mesh "Fold"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (1, 1, 0.5)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0.25, 0.25), (0.75, 0.25), (1, 0), (1, 1)] (
            interpolation = "faceVarying"
        )
    }

    # faceVarying displayColor with disagreeing corners splits the same
    # way when no st primvar exists.
    def Mesh "ColorSeam"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 2, 1, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (1, 1, 0)]
        color3f[] primvars:displayColor = [(0.1, 0.1, 0.1), (0.2, 0.2, 0.2), (1, 0, 0), (0, 0, 1), (0.2, 0.2, 0.2), (0.3, 0.3, 0.3)] (
            interpolation = "faceVarying"
        )
    }
}
