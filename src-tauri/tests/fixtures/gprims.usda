#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Box"
    {
        double size = 4
        color3f[] primvars:displayColor = [(1, 0, 0)]
    }

    def Cube "ZeroBox"
    {
        double size = 0
    }

    def Plane "Floor"
    {
        double width = 6
        double length = 3
        uniform token axis = "Y"
        float3[] primvars:displayColor = [(0.2, 0.6, 0.2), (0.1, 0.3, 0.1), (0.3, 0.9, 0.3), (0.4, 0.4, 0.4)] (
            interpolation = "vertex"
        )
    }

    def Plane "Wall"
    {
        double width = 6
        double length = 3
        uniform token axis = "X"
    }

    def Plane "Ceiling"
    {
        double width = 4
        double length = 2
    }

    def Cylinder "Post"
    {
        double height = 4
        double radius = 0.5
        uniform token axis = "X"
    }

    def Cylinder "Pancake"
    {
        double height = 0
        double radius = 1
    }

    def Cone "Spike"
    {
        double height = 3
        double radius = 1
    }

    def Capsule "Pill"
    {
        double height = 2
        double radius = 0.5
        uniform token axis = "X"
    }

    def Cylinder_1 "Frustum"
    {
        double height = 2
        double radiusTop = 0.2
        double radiusBottom = 1
        uniform token axis = "Z"
    }

    def Cylinder_1 "Needle"
    {
        double height = 2
        double radiusTop = 0
        double radiusBottom = 0
    }

    def Capsule_1 "FrustumPill"
    {
        double height = 2
        double radiusTop = 0.5
        double radiusBottom = 1
    }
}
