#usda 1.0
(
    defaultPrim = "Model"
)

# Blocker 5 fixture asset: one static mesh and one deforming mesh, so a
# filtered delta walk of the prototype emits only Wobble while a full
# walk emits both.
def Xform "Model"
{
    def Mesh "Static"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Mesh "Wobble"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points.timeSamples = {
            1: [(-1, 0, 0), (1, 0, 0), (0, 1, 0)],
            2: [(-1, 0, 0), (1, 0, 0), (0, 2, 0)],
        }
    }
}
