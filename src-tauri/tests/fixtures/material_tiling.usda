#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    def Mesh "TiledBall"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/Tiled>
    }

    def Mesh "PlainBall"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, 0, 0), (1, 0, 0), (0, 1, 0)]
        rel material:binding = </World/Looks/Plain>
    }

    def Scope "Looks"
    {
        def Material "Tiled"
        {
            token outputs:surface.connect = </World/Looks/Tiled/PreviewSurface.outputs:surface>

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "uv"
                float2 outputs:result
            }
            def Shader "UvTransform2d"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/Looks/Tiled/StReader.outputs:result>
                float inputs:rotation = 90
                float2 inputs:scale = (6, 10)
                float2 inputs:translation = (0.25, -0.5)
                float2 outputs:result
            }
            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float4 inputs:bias = (-1, -1, -1, 0)
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/Tiled/UvTransform2d.outputs:result>
                token inputs:wrapS = "mirror"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
            def Shader "NormalMap"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float2 inputs:st.connect = </World/Looks/Tiled/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Tiled/Albedo.outputs:rgb>
                normal3f inputs:normal.connect = </World/Looks/Tiled/NormalMap.outputs:rgb>
                token outputs:surface
            }
        }

        def Material "Plain"
        {
            token outputs:surface.connect = </World/Looks/Plain/PreviewSurface.outputs:surface>

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./checker.png@
                float3 outputs:rgb
            }
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Plain/Albedo.outputs:rgb>
                token outputs:surface
            }
        }
    }
}
